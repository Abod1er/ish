import requests
from telethon import TelegramClient

def check_tiktok_account_available(username):
    api_url = f"https://api.tiktok.com/oauth/user_info/?username={username}"
    
    try:
        response = requests.get(api_url)
        return response.status_code == 200
    except Exception as e:
        print(f"Error checking TikTok account: {str(e)}")
        return None

